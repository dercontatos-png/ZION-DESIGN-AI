{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/designbuilder/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/temp/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/thumbnails/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/results/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/generated-images/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api|assets|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}