# ==============================================================================
# ZION BUILDER - LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Cloud Platform Project ID used for Vertex AI Billing & Operations
GOOGLE_CLOUD_PROJECT=velvety-column-469002-p7

# Application Default Credentials path (ADC)
# The application automatically checks for 'chave-vertex.json' in the root directory.
# Ensure your service account JSON file is placed there or set this path:
GOOGLE_APPLICATION_CREDENTIALS=./chave-vertex.json

# (Optional) Google Studio standard API keys fallback
GOOGLE_CLOUD_API_KEY=YOUR_GOOGLE_CLOUD_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
API_KEY=YOUR_GOOGLE_API_KEY

# Application Port
PORT=3000
