# ==============================================================================
# ZION BUILDER - LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Cloud Platform Project ID used for Vertex AI Billing & Operations
GOOGLE_CLOUD_PROJECT=

# Application Default Credentials path (ADC)
GOOGLE_APPLICATION_CREDENTIALS=./chave-vertex.json

# (Optional) Google Studio standard API keys fallback
GOOGLE_CLOUD_API_KEY=
GEMINI_API_KEY=
API_KEY=

# Pinterest OAuth Integration
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/pinterest/callback

# Application Port
PORT=3000
